# =============================================================================
# eslefi/gs environment template. Copy to `.env` (gitignored) and fill in.
#
# Settings fall into THREE tiers with different delivery mechanisms. Which tier
# a value lives in is not cosmetic — it decides whether the value does anything.
#
#   TIER 1  Container shape         -> read by docker compose (mem/cpu/TZ)
#   TIER 2  Image-honoured env      -> passed into the container's environment
#   TIER 3  Game/LinuxGSM settings  -> written into the volume by
#                                      `./manage.sh apply-config <server|all>`
#
# TIER 3 IS THE IMPORTANT ONE. The LinuxGSM images consume exactly the variables
# listed under Tier 2 and nothing else, so a game setting can never take effect
# just by being in the environment — `max-players` in compose's `environment:`
# would be a variable the server never reads. `apply-config` writes them into
# the config files in the volume instead:
#
#     ./manage.sh apply-config all && ./manage.sh restart all
#
# Tier 3 values may be set EITHER here OR as environment variables in Coolify.
# apply-config reads the container's environment first and falls back to this
# file, so Coolify wins over a stale local value. Setting them in Coolify keeps
# one source of truth and works on hosts that have no .env at all. Note the
# container environment is only a transport here — LinuxGSM still ignores these
# variables; apply-config is what turns them into config.
#
# Naming convention for Tier 3 (this is why no key is missing):
#   <SERVICE>_LGSM_<key>   -> LinuxGSM  /data/config-lgsm/<script>/<script>.cfg
#   MINECRAFT_PROP_<key>   -> Minecraft /data/serverfiles/server.properties
#   PROJECT_ZOMBOID_INI_<key>        -> PZ   /data/Zomboid/Server/pzserver.ini
#   SEVEN_DAYS_TO_DIE_XML_<Property> -> 7DTD /data/serverfiles/sdtdserver.xml
#
# Any setting the game supports is reachable through the matching prefix, even
# if it is not listed below. Key translation for MINECRAFT_PROP_ only:
# `_` becomes `-`, and a leading `query_`/`rcon_` becomes `query.`/`rcon.`
# (so MINECRAFT_PROP_max_players -> max-players, _query_port -> query.port).
# LinuxGSM keys are lowercased; INI and XML keys are used exactly as written.
# =============================================================================


# =============================================================================
# TIER 1 - Container shape (docker compose)
# =============================================================================
# Sized for 10 concurrent players per server. See the README "Sizing" table.
#
# *_MEMORY_LIMIT is the CONTAINER limit. For the two Java servers it is NOT what
# bounds the game's memory — Minecraft is bounded by MINECRAFT_LGSM_JAVARAM and
# Project Zomboid by -Xmx in ProjectZomboid64.json. The container limit must
# always EXCEED the game heap, never equal it.

TZ=Europe/Helsinki

# Host directory holding one folder per server, bind-mounted to /data.
# Must be an ABSOLUTE path: a relative one would resolve inside Coolify's
# per-deployment checkout directory and change on every deploy.
# Folders must be owned by GS_UID:GS_GID (1000:1000 by default).
GS_DATA_ROOT=/opt/gs

# CPU limits intentionally total 11 on an 8-core host: these games are
# single-thread bound and are not expected to peak simultaneously.
MINECRAFT_MEMORY_LIMIT=8g
MINECRAFT_CPU_LIMIT=3

PROJECT_ZOMBOID_MEMORY_LIMIT=14g
PROJECT_ZOMBOID_CPU_LIMIT=3

VALHEIM_MEMORY_LIMIT=6g
VALHEIM_CPU_LIMIT=2

SEVEN_DAYS_TO_DIE_MEMORY_LIMIT=16g
SEVEN_DAYS_TO_DIE_CPU_LIMIT=3


# =============================================================================
# TIER 2 - Image-honoured environment variables
# =============================================================================
# The complete set the LinuxGSM images actually read (verified against
# /app/entrypoint.sh and /app/entrypoint-user.sh). Applied on container start.

# Auto-update check interval in MINUTES. Empty or 0 DISABLES update checks.
# 60 is the image's own default and is currently active; leaving this blank
# would override that default and silently turn update checks off.
# This installs a crontab inside the container.
GS_UPDATE_CHECK=60

# Run `validate` instead of `update` on every container start. Slower and
# re-downloads corrupt files; leave false for normal operation.
GS_VALIDATE_ON_START=false

# File ownership for the /data volume. Match these to the host user that owns
# the bind/volume data if you ever move off named volumes.
GS_UID=1000
GS_GID=1000

# LinuxGSM source. Only change to test an unreleased LinuxGSM branch — a
# non-master branch makes the container wipe and re-pull its modules on start.
LGSM_GITHUBUSER=GameServerManagers
LGSM_GITHUBREPO=LinuxGSM
LGSM_GITHUBBRANCH=master

# Enable LinuxGSM developer mode.
LGSM_DEV=false


# =============================================================================
# TIER 3a - Minecraft
# =============================================================================
# LinuxGSM (/data/config-lgsm/mcserver/mcserver.cfg)

# JVM max heap in MB. THIS is Minecraft's real memory limit, not
# MINECRAFT_MEMORY_LIMIT. LinuxGSM's default is 1024 (1 GB), far below the
# documented 4-8 GB for 10 players. Keep it under the container limit so JVM
# non-heap memory (metaspace, code cache, thread stacks, GC) still fits.
MINECRAFT_LGSM_JAVARAM=6144

# release | snapshot     and     latest | a pinned version such as 1.21.4
#MINECRAFT_LGSM_BRANCH=release
#MINECRAFT_LGSM_MCVERSION=latest

# server.properties
#MINECRAFT_PROP_max_players=20
#MINECRAFT_PROP_motd=A Minecraft Server
#MINECRAFT_PROP_difficulty=easy
#MINECRAFT_PROP_gamemode=survival
#MINECRAFT_PROP_hardcore=false
#MINECRAFT_PROP_pvp=true
#MINECRAFT_PROP_view_distance=10
#MINECRAFT_PROP_simulation_distance=10
#MINECRAFT_PROP_level_name=world
#MINECRAFT_PROP_level_seed=
#MINECRAFT_PROP_online_mode=true
#MINECRAFT_PROP_white_list=false
#MINECRAFT_PROP_enforce_whitelist=false
#MINECRAFT_PROP_spawn_protection=16
#MINECRAFT_PROP_enable_command_block=false
#MINECRAFT_PROP_allow_flight=false
#MINECRAFT_PROP_allow_nether=true
#MINECRAFT_PROP_max_world_size=29999984
#MINECRAFT_PROP_server_port=25565
#MINECRAFT_PROP_enable_query=true
#MINECRAFT_PROP_query_port=25565           # -> query.port
#MINECRAFT_PROP_enable_rcon=false
#MINECRAFT_PROP_rcon_port=25575            # -> rcon.port
#MINECRAFT_PROP_rcon_password=             # -> rcon.password


# =============================================================================
# TIER 3b - Project Zomboid
# =============================================================================
# LinuxGSM (/data/config-lgsm/pzserver/pzserver.cfg)

# REQUIRED. Without it the server blocks forever on an interactive
# "Enter new administrator password:" prompt and never binds its ports.
PROJECT_ZOMBOID_LGSM_ADMINPASSWORD=change-me-before-first-start

# Passing -adminpassword keeps the first-start prompt from ever appearing.
# Keep the password here in sync with PROJECT_ZOMBOID_LGSM_ADMINPASSWORD.
# Single-quoted so nothing is expanded when the file is sourced.
PROJECT_ZOMBOID_LGSM_STARTPARAMETERS='-servername pzserver -adminpassword change-me-before-first-start'

#PROJECT_ZOMBOID_LGSM_IP=0.0.0.0

# Server .ini (/data/Zomboid/Server/pzserver.ini)
#PROJECT_ZOMBOID_INI_MaxPlayers=16
#PROJECT_ZOMBOID_INI_PublicName=LinuxGSM
#PROJECT_ZOMBOID_INI_PublicDescription=
#PROJECT_ZOMBOID_INI_Public=false
#PROJECT_ZOMBOID_INI_Open=true
#PROJECT_ZOMBOID_INI_Password=
#PROJECT_ZOMBOID_INI_PVP=true
#PROJECT_ZOMBOID_INI_PauseEmpty=true
#PROJECT_ZOMBOID_INI_ServerWelcomeMessage=
#PROJECT_ZOMBOID_INI_DefaultPort=16261
#PROJECT_ZOMBOID_INI_UDPPort=16262
#PROJECT_ZOMBOID_INI_RCONPort=27015
#PROJECT_ZOMBOID_INI_RCONPassword=
#PROJECT_ZOMBOID_INI_SaveWorldEveryMinutes=0
#PROJECT_ZOMBOID_INI_BackupsOnStart=true
#PROJECT_ZOMBOID_INI_BackupsCount=5


# =============================================================================
# TIER 3c - Valheim
# =============================================================================
# Valheim has no game config file — every setting is a LinuxGSM start parameter
# (/data/config-lgsm/vhserver/vhserver.cfg).

# REQUIRED. Minimum 5 characters and must differ from the server name, or
# Valheim refuses to start and LinuxGSM restarts it in a loop.
VALHEIM_LGSM_SERVERPASSWORD=change-me-before-first-start

#VALHEIM_LGSM_SERVERNAME=LinuxGSM
#VALHEIM_LGSM_PORT=2456
#VALHEIM_LGSM_WORLDNAME=vhserver
#VALHEIM_LGSM_PUBLIC=1
#VALHEIM_LGSM_SAVEINTERVAL=1800
#VALHEIM_LGSM_BACKUPS=4
#VALHEIM_LGSM_BACKUPSHORT=7200
#VALHEIM_LGSM_BACKUPLONG=43200
#VALHEIM_LGSM_INSTANCEID=1
# Combine world modifiers, e.g. "-preset hard" or "-modifier raids none"
#VALHEIM_LGSM_WORLDMODIFIERS=


# =============================================================================
# TIER 3d - 7 Days to Die
# =============================================================================
# LinuxGSM (/data/config-lgsm/sdtdserver/sdtdserver.cfg)
#SEVEN_DAYS_TO_DIE_LGSM_IP=0.0.0.0

# sdtdserver.xml. Property names are used verbatim, exactly as in the XML.
# The server refuses connections beyond ServerMaxPlayerCount regardless of how
# much memory the container has.
SEVEN_DAYS_TO_DIE_XML_ServerMaxPlayerCount=10

#SEVEN_DAYS_TO_DIE_XML_ServerName=My Game Host
#SEVEN_DAYS_TO_DIE_XML_ServerDescription=
#SEVEN_DAYS_TO_DIE_XML_ServerPassword=
#SEVEN_DAYS_TO_DIE_XML_ServerPort=26900
#SEVEN_DAYS_TO_DIE_XML_ServerVisibility=2
#SEVEN_DAYS_TO_DIE_XML_GameWorld=Navezgane
#SEVEN_DAYS_TO_DIE_XML_GameName=My Game
#SEVEN_DAYS_TO_DIE_XML_GameDifficulty=1
#SEVEN_DAYS_TO_DIE_XML_WorldGenSize=6144
#SEVEN_DAYS_TO_DIE_XML_WorldGenSeed=
#SEVEN_DAYS_TO_DIE_XML_DayNightLength=60
#SEVEN_DAYS_TO_DIE_XML_ZombiesRun=0
#SEVEN_DAYS_TO_DIE_XML_BloodMoonFrequency=7
#SEVEN_DAYS_TO_DIE_XML_BloodMoonEnemyCount=8
#SEVEN_DAYS_TO_DIE_XML_LandClaimCount=3
#SEVEN_DAYS_TO_DIE_XML_DropOnDeath=1
#SEVEN_DAYS_TO_DIE_XML_TelnetEnabled=true
#SEVEN_DAYS_TO_DIE_XML_TelnetPort=8081
#SEVEN_DAYS_TO_DIE_XML_TelnetPassword=
#SEVEN_DAYS_TO_DIE_XML_ControlPanelEnabled=false


# =============================================================================
# Optional: LinuxGSM alerts (any service; repeat per prefix)
# =============================================================================
#MINECRAFT_LGSM_DISCORDALERT=on
#MINECRAFT_LGSM_DISCORDWEBHOOK=https://discord.com/api/webhooks/...
#MINECRAFT_LGSM_EMAILALERT=off
#MINECRAFT_LGSM_EMAIL=
#MINECRAFT_LGSM_MAXBACKUPS=4
#MINECRAFT_LGSM_MAXBACKUPDAYS=30
#MINECRAFT_LGSM_STOPONBACKUP=on
